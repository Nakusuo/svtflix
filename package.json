{
  "name": "svtflix",
  "version": "0.1.0",
  "private": true,
  "description": "SVTFLIX en Español: sitio fan de SEVENTEEN, estático, con el contenido en Google Sheets.",
  "type": "module",
  "scripts": {
    "build": "node tools/preparar.mjs && tailwindcss -i src/styles.css -o web/css/styles.css --minify",
    "dev:css": "tailwindcss -i src/styles.css -o web/css/styles.css --watch",
    "dev:web": "python3 -m http.server 5500 --directory web",
    "dev": "npm run build && (npm run dev:css & npm run dev:web)",
    "logo": "node tools/logo.mjs"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@tailwindcss/cli": "^4.3.4",
    "opentype.js": "^1.3.4",
    "tailwindcss": "^4.3.4"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
